<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.WidScore"
        android:allowBackup="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.ScoreWidgetClassicProvider"
            android:exported="false"
            android:label="@string/widget_classic_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_classic_info" />
        </receiver>

        <receiver
            android:name=".widget.ScoreWidgetDarkProvider"
            android:exported="false"
            android:label="@string/widget_dark_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dark_info" />
        </receiver>
        <service
            android:name=".widget.MatchListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".widget.WidgetUpdateWorker$RefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.widscore.ACTION_REFRESH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
